{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "@LOGO@",
    "color": { "1": "magenta", "2": "cyan" },
    "padding": { "right": 3 }
  },
  "display": {
    "color": { "keys": "magenta", "title": "cyan" }
  },
  "modules": [
    "title",
    { "type": "custom", "format": "CREATED BY: BARATH" },
    { "type": "custom", "key": "TITAN OS", "format": "version @VERSION@" },
    "break",
    "os",
    "kernel",
    { "type": "command", "key": "Architecture", "text": "uname -m" },
    "cpu",
    "gpu",
    "memory",
    "terminal",
    "shell",
    "de",
    "uptime",
    "packages"
  ]
}
